{
  "name": "zinsight",
  "version": "0.10.0",
  "description": "Instant insight into any codebase. Auto-generate rich architecture docs with Mermaid diagrams, API endpoints, database schemas, external integrations, tech stack detection, and code health analysis. Built for AI-generated codebases.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zinsight": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "documentation",
    "docs",
    "explainability",
    "code-analysis",
    "ast",
    "dependency-graph",
    "onboarding",
    "developer-experience",
    "vibe-coding",
    "ai-generated-code"
  ],
  "author": "zinwave",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zinwave/zinsight.git"
  },
  "homepage": "https://github.com/zinwave/zinsight#readme",
  "bugs": {
    "url": "https://github.com/zinwave/zinsight/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "glob": "^10.3.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
